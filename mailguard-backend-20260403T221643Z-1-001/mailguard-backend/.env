# Port du serveur
PORT=5000

# Adresse de ta base de données MongoDB locale
MONGO_URI=mongodb://localhost:27017/mailguard

# Clé secrète pour générer les tokens JWT
# (mets n'importe quelle longue chaîne de caractères)
JWT_SECRET=mailguard_secret_key_change_moi_2024

# Durée de validité du token (24 heures)
JWT_EXPIRE=24h